{
  "version": 2,
  "installCommand": "npm install --prefix server && npm install --prefix client-tryon",
  "buildCommand": "npm run build --prefix client-tryon",
  "outputDirectory": "client-tryon/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/uploads/(.*)", "destination": "/api" },
    {
      "source": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|map))",
      "destination": "/$1"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
