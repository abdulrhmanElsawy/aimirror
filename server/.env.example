# =============================================================================
# AIMirror API — environment variables
# Copy to .env for local dev. Set the same keys in Vercel → Project → Settings → Environment Variables.
# =============================================================================

# --- Database (required) ---
# Local:
MONGO_URI=mongodb://localhost:27017/clothing-store
# Vercel / production example:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/aimirror

# --- Auth (required for admin) ---
JWT_SECRET=your_jwt_secret_here

# --- Server ---
PORT=5000
# Vercel sets VERCEL=1 and often NODE_ENV=production automatically.
NODE_ENV=development

# --- CORS: browser origins allowed to call this API (required in production) ---
# Vercel examples (adjust to your real deployment URLs):
# CLIENT_STORE_URL=https://your-store.vercel.app
# CLIENT_TRYON_URL=https://your-tryon.vercel.app
CLIENT_STORE_URL=http://localhost:5173
CLIENT_TRYON_URL=http://localhost:5174

# --- Public base URL of THIS API (used for WhatsApp media links, absolute image URLs) ---
# Vercel: use your deployment URL that serves /api and /uploads, e.g. https://your-project.vercel.app
PUBLIC_BASE_URL=http://localhost:5000

# --- Google Gemini (required for try-on image generation) ---
GEMINI_API_KEY=your_gemini_api_key_here
# Optional overrides (defaults are set in code):
# GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
# GEMINI_TEXT_MODEL=gemini-1.5-flash

# --- Email / SMTP (optional; required for “send result by email”) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# --- WhatsApp (optional; choose one provider) ---
WHATSAPP_PROVIDER=twilio

# Twilio WhatsApp (code reads TWILIO_WHATSAPP_NUMBER, e.g. whatsapp:+14155238886)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Meta / Graph API WhatsApp (alternative)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# --- Try-on fallback (local testing when AI provider fails) ---
TRYON_FALLBACK_COPY_USER_IMAGE=false

# --- Legacy: Hugging Face (optional; not used when Gemini generation is active) ---
HF_API_TOKEN=
HF_INFERENCE_BASE_URL=https://router.huggingface.co/hf-inference/models
HF_SPACE_ID=yisol/IDM-VTON
HF_SPACE_API_NAME=/tryon
HF_TRYON_MODEL=
HF_TEXT_MODEL=
